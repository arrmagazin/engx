<Components>
  <Component id="Attribution">
    <Bar class="px-2 py-1 border-t border-base-300">
      <a href="{R.app.repoUrl}" target="_blank" rel="noopener noreferrer">
        <IBtn icon="github" size="sm" title="Source on GitHub" />
      </a>
      <a href="{R.app.storeUrl}" target="_blank" rel="noopener noreferrer">
        <IBtn icon="shopping-cart" size="sm" title="Buy the book" />
      </a>
    </Bar>
  </Component>

  <Component id="MDCodespan">
    <Fragment If="glossaryDefinition(R.glossary, text)">
      <Popover>
        <Text text="{text}"
          class="inline-block border mx-1 px-1 rounded text-xs font-mono font-semibold" />
        <div Slot="popover">
          <MarkdownView
            class="p-2"
            text="{glossaryDefinition(R.glossary, text)}" />
        </div>
      </Popover>
      <Else>
        <span class="inline-block border mx-1 px-1 rounded text-xs font-mono"
        >
          {text}
        </span>
      </Else>
    </Fragment>
  </Component>

</Components>