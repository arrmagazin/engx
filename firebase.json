{
  "hosting": {
    "site": "software-engineering",
    "public": "www",
    "ignore": ["firebase.json", "**/*.js.map", ".*", "CLAUDE.md"],
    "headers": [
      {
        "source": "version",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
