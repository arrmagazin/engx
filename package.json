{
  "name": "engx",
  "private": true,
  "type": "module",
  "displayName": "Software Engineering",
  "description": "Introduction to Software Engineering",
  "version": "1.0.3",
  "author": "Irvin Oldman",
  "publisher": "https://irvin-oldman.myshopify.com/pages/contact",
  "copyright": "© 2026 Irvin Oldman. CC BY-NC-SA 4.0.",
  "license": "CC-BY-NC-SA-4.0",
  "storeUrl": "https://irvin-oldman.myshopify.com/products/introduction-to-software-engineering",
  "repository": {
    "url": "https://github.com/arrmagazin/engx"
  },
  "keywords": [
    "engineering",
    "software"
  ],
  "book": {
    "title": "Introduction to Software Engineering",
    "subtitle": "The distilled knowledge for practising engineers",
    "language": "en-GB",
    "description": "A reference book covering the most fields of knowledge every Software engineer must know.",
    "subject": [
      "Software engineering",
      "System design",
      "Cloud computing"
    ],
    "coverPhoto": "cover.png"
  },
  "hotPort": 8192,
  "scripts": {
    "link": "proton link-modules",
    "postinstall": "npm run link",
    "start": "export PORT=${PORT:-8092} && npm run stop && npm run glossary && npx --yes npm-run-all --parallel start:*",
    "start:serve": "bun ../../libs/arrmatura-books/scripts/serve.ts",
    "start:css": "npm run build:css -- --watch",
    "start:index": "npm run build:index -- --watch",
    "start:hot": "proton hot www/dist $(jq .hotPort package.json)",
    "start:open": "npx --yes wait-on http://localhost:${PORT:-8092} && open http://localhost:${PORT:-8092}/",
    "stop": "lsof -t -sTCP:LISTEN -i tcp:${PORT:-8092},$(jq .hotPort package.json) | xargs -r kill -9",
    "check": "npx --yes npm-run-all --continue-on-error check:*",
    "check:frontmatter": "git ls-files 'docs/*.md' | xargs bun ../../libs/arrmatura-books/scripts/check-okf-frontmatter.ts",
    "check:glossary": "git ls-files 'docs/*.md' | xargs bun ../../libs/arrmatura-books/scripts/check-glossary.ts",
    "check:links": "git ls-files 'docs/*.md' | xargs bun ../../libs/arrmatura-books/scripts/check-links.ts",
    "check:diagrams": "git ls-files -z 'docs/*.md' | xargs -0 bun ../../libs/arrmatura-markdown/scripts/check-diagrams.ts",
    "glossary": "git ls-files 'docs/*.md' | xargs bun ../../libs/arrmatura-books/scripts/build-glossary.ts",
    "prebuild": "npm run glossary",
    "build": "npx --yes npm-run-all --parallel build:*",
    "build:ts": "bun ../../libs/arrmatura-books/scripts/build.ts",
    "build:index": "proton index-docs docs",
    "build:sitemap": "proton sitemap https://software-engineering.web.app docs",
    "build:css": "proton build-css",
    "book": "bun ../../libs/arrmatura-books/book/build.ts",
    "gates": "npm run check",
    "predeploy": "npm run build",
    "deploy": "firebase deploy --only hosting -P parlang"
  },
  "esbuild": {
    "entryPoints": [
      "index.ts"
    ]
  },
  "devDependencies": {
    "daisyui": "^5.7.50",
    "proton": "file://../../libs/proton",
    "tailwindcss": "^4.3.3"
  }
}
