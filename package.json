{
  "name": "engx",
  "private": true,
  "type": "module",
  "displayName": "Software Engineering",
  "description": "Introduction to Software Engineering",
  "version": "1.0.3",
  "author": "Irvin Oldman",
  "publisher": "https://irvin-oldman.myshopify.com/pages/contact",
  "copyright": "© 2026 Irvin Oldman. CC BY-NC-SA 4.0.",
  "license": "CC-BY-NC-SA-4.0",
  "storeUrl": "https://irvin-oldman.myshopify.com/products/introduction-to-software-engineering",
  "repository": {
    "url": "https://github.com/arrmagazin/engx"
  },
  "keywords": [
    "engineering",
    "software"
  ],
  "book": {
    "title": "Introduction to Software Engineering",
    "subtitle": "The distilled knowledge for practising engineers",
    "language": "en-GB",
    "description": "A reference book covering the most fields of knowledge every Software engineer must know.",
    "subject": [
      "Software engineering",
      "System design",
      "Cloud computing"
    ],
    "coverPhoto": "cover.png"
  },
  "hotPort": 8192,
  "scripts": {
    "start": "export PORT=${PORT:-8092} && npm run stop && npx --yes npm-run-all --parallel start:*",
    "start:serve": "bun ../arrmatura-books/scripts/serve.ts",
    "start:css": "npm run build:css -- --watch",
    "start:index": "npm run build:index -- --watch",
    "start:hot": "bun ../arrmatura-web/devops/hot/server/main.ts www/dist $(jq .hotPort package.json)",
    "start:open": "npx --yes wait-on http://localhost:${PORT:-8092} && open http://localhost:${PORT:-8092}/",
    "stop": "lsof -t -sTCP:LISTEN -i tcp:${PORT:-8092},$(jq .hotPort package.json) | xargs -r kill -9",
    "check": "npx --yes npm-run-all --continue-on-error check:*",
    "check:frontmatter": "git ls-files 'docs/*.md' | xargs bun ../arrmatura-books/scripts/check-okf-frontmatter.ts",
    "check:glossary": "git ls-files 'docs/*.md' | xargs bun ../arrmatura-books/scripts/check-glossary.ts",
    "check:links": "git ls-files 'docs/*.md' | xargs bun ../arrmatura-books/scripts/check-links.ts",
    "build": "npx --yes npm-run-all --parallel build:*",
    "build:ts": "bun ../arrmatura-books/scripts/build.ts",
    "build:index": "bun ../proton/ops/index-docs.ts docs",
    "build:css": "npx --yes @tailwindcss/cli -i index.css -o \"$PWD/www/dist/index.css\"",
    "book": "bun ../arrmatura-books/book/build.ts",
    "predeploy": "npm run build",
    "deploy": "firebase deploy --only hosting -P parlang"
  },
  "esbuild": {
    "entryPoints": [
      "index.ts"
    ]
  },
  "devDependencies": {
    "daisyui": "^5.7.50",
    "tailwindcss": "^4.3.3",
    "esbuild": "^0.28.2"
  }
}
